# ==============================================================
# GITIGNORE FOR FULL-STACK LLM APPLICATION
# ==============================================================

# --------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL!)
# --------------------------------------------------------------
# Never commit real API keys, Supabase service roles, or secrets!
.env
.env.*
*.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Preserve template files so other developers know which keys to configure
!.env.example
!backend/.env.example
!frontend/.env.example

# --------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGERS
# --------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# --------------------------------------------------------------
# 3. LOGS & RUNTIME DATA
# --------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------
# 4. OS-GENERATED FILES
# --------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~

# --------------------------------------------------------------
# 5. CODE EDITORS & IDE CONFIGURATIONS
# --------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/
.buildpath

# AI & Agent artifacts
.gemini/
.claude/

# --------------------------------------------------------------
# 6. BUILD & TEMPORARY DIRECTORIES
# --------------------------------------------------------------
dist/
build/
out/
.cache/
tmp/
temp/
scratch/
*.tmp
*.bak
